    <AnchorPane xmlns="http://javafx.com/javafx"
                xmlns:fx="http://javafx.com/fxml/1"
                fx:controller="com.neklin.AppController"
                stylesheets="style.css"
                prefWidth="800" prefHeight="500">

        <!-- Подсказка сверху справа -->
        <Label fx:id="tip" text="?" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #666;"
               AnchorPane.topAnchor="15" AnchorPane.rightAnchor="20"/>

        <!-- Таблица - растягивается на всю ширину и высоту -->
        <TableView fx:id="taskTable"
                   AnchorPane.topAnchor="15"
                   AnchorPane.leftAnchor="20"
                   AnchorPane.rightAnchor="240"
                   AnchorPane.bottomAnchor="70">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50" maxWidth="50" minWidth="50" resizable="false"/>
                <TableColumn fx:id="nameColumn" text="Название" prefWidth="300" minWidth="150"/>
                <TableColumn fx:id="dateColumn" text="Дата" prefWidth="150" minWidth="120"/>
            </columns>
        </TableView>

        <HBox spacing="10" alignment="CENTER"
              AnchorPane.bottomAnchor="20"
              AnchorPane.leftAnchor="20"
              AnchorPane.rightAnchor="240">
            <TextField fx:id="taskField" promptText="Введите задачу" prefWidth="300" style="-fx-font-size: 14px;"/>
        </HBox>

        <!-- Кнопка для добавления -->
    <padding>
        <Insets bottom="20.0" left="20.0" right="10.0" top="20.0"/>
    </padding>
    </AnchorPane>

